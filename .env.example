# =====================================================================
# DanzaCheck - variables de entorno
#
# Copia este archivo como .env y cambia los valores. El archivo .env esta
# en el .gitignore: nunca se sube al repositorio.
#   copy .env.example .env
#
# Ninguno de estos valores es real. En produccion deben generarse de
# forma aleatoria, en especial JWT_SECRET.
# =====================================================================

# --- Servidor ---
# Render inyecta PORT automaticamente; en local normalmente es 8080.
PORT=8080

# --- Base de datos PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/danzacheck
DB_USERNAME=danza
DB_PASSWORD=cambia-esta-clave

# --- Esquema ---
# update en desarrollo. En produccion conviene "validate" junto con
# migraciones (ver README, seccion "Base de datos").
DDL_AUTO=update

# --- Administrador unico del panel ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave

# --- JWT ---
# Minimo 32 caracteres. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32-caracteres
JWT_ISSUER=danzacheck
JWT_EXPIRATION_MINUTES=480

# --- CORS ---
# Origen del frontend React, sin barra final.
FRONTEND_URL=http://localhost:5173
