# =====================================================================
# DanzaCheck - variables de entorno
#   copy .env.example .env     y reemplaza los <>
# El .env esta en .gitignore: no se sube.
# =====================================================================

# --- Supabase ---
# Button Connect > Session pooler > copiar el string y pegalo aqui,
# reemplazando [YOUR-PASSWORD] por la contrasena de la base de datos
# (Project Settings > Database > Database password).
# Si la clave tiene @ : o /, codificalos: %40 %3A %2F
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# validate = no crea el esquema. Aplika antes db/01-schema.sql y
# db/02-row-level-security.sql en el SQL Editor de Supabase.
DDL_AUTO=validate

# --- Panel ---
ADMIN_USERNAME=<usuario-del-panel>
ADMIN_PASSWORD=<contrasena-fuerte>

# --- JWT (minimo 32 caracteres, si no la app no arranca) ---
# openssl rand -base64 48
JWT_SECRET=<secreto-aleatorio>
JWT_ISSUER=danzacheck
JWT_EXPIRATION_MINUTES=480

# --- CORS: en local http://localhost:5173, en Vercel https://<tu-app>.vercel.app ---
FRONTEND_URL=http://localhost:5173

# --- Stream SSE ---
STREAM_HEARTBEAT_MS=25000
STREAM_TIMEOUT_MS=0
